# Optional: dedicated RPC endpoint prepended to the public RPC pool.
# Set this for production to avoid rate limits on public endpoints.
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: override the cache TTL (seconds) for positive resolution results.
# RESOLVE_TTL=300

# Optional: override the cache TTL (seconds) for negative resolution results.
# RESOLVE_NEG_TTL=60

# Optional: override the cache TTL (seconds) for proxied content.
# CONTENT_TTL=300
