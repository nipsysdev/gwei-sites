{
  "tasks": {
    "dev": "deno serve --watch --allow-net --allow-env=RPC_KEY,RPC_KEY_FALLBACK,DEDICATED_GATEWAY,PIN_TOKEN main.ts",
    "start": "deno run --allow-net --allow-env=RPC_KEY,RPC_KEY_FALLBACK,DEDICATED_GATEWAY,PIN_TOKEN main.ts",
    "test": "deno test --allow-env=RPC_KEY,RPC_KEY_FALLBACK,DEDICATED_GATEWAY,PIN_TOKEN",
    "test:coverage": "deno test --coverage=cov/ --allow-env=RPC_KEY,RPC_KEY_FALLBACK,DEDICATED_GATEWAY,PIN_TOKEN",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check main.ts",
    "ci": "deno fmt --check && deno lint && deno test --coverage=cov/ --allow-env=RPC_KEY,RPC_KEY_FALLBACK,DEDICATED_GATEWAY,PIN_TOKEN"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"],
    "noImplicitAny": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "lint": {
    "include": ["src/", "main.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "test": {
    "include": ["src/"]
  },
  "exclude": ["cov/"],
  "deploy": {
    "org": "gwei-site",
    "app": "gwei-site",
    "runtime": {
      "mode": "dynamic",
      "entrypoint": "main.ts"
    }
  }
}
