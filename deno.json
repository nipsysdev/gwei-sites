{
  "tasks": {
    "dev": "deno serve --watch --allow-net main.ts",
    "start": "deno run --allow-net main.ts",
    "test": "deno test",
    "test:coverage": "deno test --coverage=cov/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check main.ts",
    "ci": "deno fmt --check && deno lint && deno test --coverage=cov/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"],
    "noImplicitAny": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "lint": {
    "include": ["src/", "main.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "test": {
    "include": ["src/"]
  },
  "exclude": ["cov/"],
  "deploy": {
    "org": "gwei-site",
    "app": "gwei-site",
    "runtime": {
      "mode": "dynamic",
      "entrypoint": "main.ts"
    }
  }
}
